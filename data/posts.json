const STORAGE_KEY_POSTS = 'van_uyen_posts_v9';
const ADMIN_PASS_KEY = 'van_uyen_admin_pass';

const state = {
  posts: [],
  adminLoggedIn: sessionStorage.getItem('isAdminLoggedIn') === 'true'
};

function showMsg(message) {
  const toast = document.getElementById('toastMessage');
  const text = document.getElementById('toastMessageText');
  if (!toast || !text) {
    alert(message);
    return;
  }
  text.textContent = message;
  toast.classList.remove('hidden');
  clearTimeout(window.__toastTimer);
  window.__toastTimer = setTimeout(() => toast.classList.add('hidden'), 3500);
}

function showConfirm(message, callback) {
  const modal = document.getElementById('confirmModal');
  const msg = document.getElementById('confirmMessage');
  const okBtn = document.getElementById('confirmOkBtn');
  if (!modal || !msg || !okBtn) {
    if (window.confirm(message)) callback();
    return;
  }
  msg.textContent = message;
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  okBtn.onclick = function () {
    closeConfirm();
    callback();
  };
}

function closeConfirm() {
  const modal = document.getElementById('confirmModal');
  if (modal) {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
}

function renderCard(post, type) {
  if (type === 'thilan') {
    return `
      <article class="fade-up rounded-2xl bg-parchment p-6 ornate-card">
        <span class="text-[11px] font-cormorant font-bold uppercase tracking-[0.2em] text-goldAccent">Thơ Xướng Họa Cộng Đồng</span>
        <h3 class="mt-2 text-2xl font-cormorant font-bold text-wineRed">${post.title}</h3>
        <p class="mt-3 whitespace-pre-line text-gray-700 italic leading-relaxed">"${post.content}"</p>
        <div class="mt-4 flex items-center justify-between border-t border-goldAccent/30 pt-3 text-xs text-gray-500 font-cormorant">
          <span>Tác giả: ${post.author}</span>
          <span class="font-semibold text-green-700">Đã xuất bản</span>
        </div>
      </article>
    `;
  }

  if (type === 'dientich') {
    return `
      <article class="fade-up rounded-xl bg-parchment p-5 ornate-card">
        <h3 class="text-xl font-cormorant font-bold text-wineRed">${post.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-700">${post.content}</p>
        <div class="mt-3 text-right text-xs italic text-gray-500 font-cormorant">Đóng góp: ${post.author}</div>
      </article>
    `;
  }

  if (type === 'danchung') {
    return `
      <article class="fade-up rounded-xl bg-parchment p-5 ornate-card">
        <h3 class="text-lg font-cormorant font-bold text-wineRed">${post.title}</h3>
        <p class="mt-2 text-sm italic leading-relaxed text-gray-700">"${post.content}"</p>
        <div class="mt-3 text-right text-xs text-gray-500 font-cormorant">Sưu tầm bởi: ${post.author}</div>
      </article>
    `;
  }

  if (type === 'binhpham') {
    return `
      <article class="fade-up rounded-2xl bg-parchment p-6 ornate-card">
        <span class="text-[11px] font-cormorant font-bold uppercase tracking-[0.2em] text-goldAccent">Bình Phẩm Chuyên Sâu</span>
        <h3 class="mt-2 text-2xl font-cormorant font-bold text-wineRed">${post.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-gray-700">${post.content}</p>
        <div class="mt-4 flex items-center justify-between border-t border-goldAccent/30 pt-3 text-xs text-gray-500 font-cormorant">
          <span>Tác giả: ${post.author}</span>
          <span class="font-semibold text-green-700">Đã kiểm duyệt</span>
        </div>
      </article>
    `;
  }

  if (type === 'sangtac') {
    return `
      <article class="fade-up flex h-full flex-col justify-between rounded-xl bg-parchment p-5 ornate-card">
        <div>
          <span class="text-[11px] font-cormorant font-bold uppercase tracking-[0.2em] text-goldAccent">${post.category}</span>
          <h3 class="mt-2 text-xl font-cormorant font-bold text-wineRed">${post.title}</h3>
          <p class="mt-3 text-sm italic leading-relaxed text-gray-700">"${post.content}"</p>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-goldAccent/30 pt-3 text-xs text-gray-500 font-cormorant">
          <span>Tác giả: ${post.author}</span>
          <span class="font-semibold text-green-700">Đã xuất bản</span>
        </div>
      </article>
    `;
  }

  return '';
}

function renderAllSections() {
  const posts = state.posts.filter((p) => p.status === 'approved');

  const thidan = posts.filter((p) => p.category === 'Thi Đàn & Xướng Họa');
  document.getElementById('thidanContainer').innerHTML = thidan.length
    ? thidan.map((p) => renderCard(p, 'thilan')).join('')
    : '<p class="col-span-full text-center text-lg italic text-gray-500 font-cormorant">Chưa có bài thơ nào được đăng tải.</p>';

  const dientich = posts.filter((p) => p.category === 'Điển Tích & Điển Cố');
  document.getElementById('dientichContainer').innerHTML = dientich.length
    ? dientich.map((p) => renderCard(p, 'dientich')).join('')
    : '<p class="col-span-full text-center text-lg italic text-gray-500 font-cormorant">Chưa có điển tích nào.</p>';

  const danchung = posts.filter((p) => p.category === 'Dẫn Chứng & Nhận Định');
  document.getElementById('danchungContainer').innerHTML = danchung.length
    ? danchung.map((p) => renderCard(p, 'danchung')).join('')
    : '<p class="col-span-full text-center text-lg italic text-gray-500 font-cormorant">Chưa có dẫn chứng nào.</p>';

  const binhpham = posts.filter((p) => p.category === 'Góc Bình Phẩm Văn Chương');
  document.getElementById('binhphamContainer').innerHTML = binhpham.length
    ? binhpham.map((p) => renderCard(p, 'binhpham')).join('')
    : '<p class="col-span-full text-center text-lg italic text-gray-500 font-cormorant">Chưa có bài bình phẩm nào.</p>';

  const sangtac = posts.filter((p) => p.category === 'Góc Sáng Tác & Bút Ký');
  document.getElementById('sangtacContainer').innerHTML = sangtac.length
    ? sangtac.map((p) => renderCard(p, 'sangtac')).join('')
    : '<p class="col-span-full text-center text-lg italic text-gray-500 font-cormorant">Chưa có bài sáng tác nào.</p>';
}

async function fetchPosts() {
  try {
    const response = await fetch('/api/posts');
    const posts = await response.json();
    state.posts = Array.isArray(posts) ? posts : [];
    renderAllSections();
    renderPendingPostsAdmin();
  } catch (error) {
    console.error('Lỗi khi tải bài viết:', error);
    showMsg('Không thể tải dữ liệu bài viết từ máy chủ.');
  }
}

async function submitPost(payload) {
  const res = await fetch('/api/posts', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });

  const data = await res.json();
  if (!res.ok) throw new Error(data.message || 'Gửi bài thất bại.');
  return data;
}

async function approvePost(id) {
  const response = await fetch(`/api/posts/${id}/approve`, { method: 'PATCH' });
  const data = await response.json();
  if (!response.ok) throw new Error(data.message || 'Duyệt thất bại');
  await fetchPosts();
  showMsg('Đã duyệt và xuất bản bài viết thành công!');
}

async function deletePost(id) {
  showConfirm('Bạn có chắc chắn muốn xóa/từ chối bài viết này?', async function () {
    const response = await fetch(`/api/posts/${id}`, { method: 'DELETE' });
    const data = await response.json();
    if (!response.ok) {
      showMsg(data.message || 'Xóa bài thất bại');
      return;
    }
    await fetchPosts();
    showMsg('Đã xóa bài viết thành công.');
  });
}

function openSubmitModal() {
  const modal = document.getElementById('submitModal');
  modal.classList.remove('hidden');
  modal.classList.add('flex');
}

function openSubmitModalWithCategory(category) {
  const select = document.getElementById('postCategory');
  if (select) select.value = category;
  openSubmitModal();
}

function closeSubmitModal() {
  const modal = document.getElementById('submitModal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
  document.getElementById('submitPostForm').reset();
}

document.getElementById('submitPostForm').addEventListener('submit', async function (e) {
  e.preventDefault();

  const title = document.getElementById('postTitle').value.trim();
  const author = document.getElementById('postAuthor').value.trim();
  const category = document.getElementById('postCategory').value;
  const content = document.getElementById('postContent').value.trim();

  if (!title || !author || !content) {
    showMsg('Vui lòng điền đầy đủ thông tin trước khi gửi bài.');
    return;
  }

  try {
    await submitPost({ title, author, category, content });
    showMsg('Bài viết của bạn đã được gửi thành công! Quản trị viên sẽ xét duyệt sớm nhất.');
    closeSubmitModal();
    await fetchPosts();
  } catch (error) {
    showMsg(error.message);
  }
});

function renderPendingPostsAdmin() {
  const container = document.getElementById('pendingPostsList');
  const pending = state.posts.filter((p) => p.status === 'pending');

  if (!container) return;

  if (!pending.length) {
    container.innerHTML = '<p class="text-sm text-gray-500 italic">Không có bài viết nào đang chờ duyệt.</p>';
    return;
  }

  container.innerHTML = pending.map((p) => `
    <div class="flex flex-col gap-4 rounded border border-gray-200 bg-gray-50 p-4 md:flex-row md:items-center md:justify-between">
      <div>
        <span class="inline-block rounded bg-amber-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-800">${p.category}</span>
        <h4 class="mt-2 text-lg font-bold text-wineRed">${p.title}</h4>
        <p class="mt-1 text-xs text-gray-600">Tác giả: <strong>${p.author}</strong></p>
        <p class="mt-2 whitespace-pre-line text-sm italic text-gray-700">"${p.content}"</p>
      </div>
      <div class="flex shrink-0 gap-2">
        <button onclick="approvePost(${p.id})" class="rounded bg-green-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-green-700 transition">Duyệt</button>
        <button onclick="deletePost(${p.id})" class="rounded bg-red-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-red-700 transition">Xóa</button>
      </div>
    </div>
  `).join('');
}

function openAdminModal() {
  const modal = document.getElementById('adminModal');
  modal.classList.remove('hidden');
  modal.classList.add('flex');

  if (sessionStorage.getItem('isAdminLoggedIn') === 'true') {
    showAdminDashboard();
  } else {
    document.getElementById('adminLoginForm').classList.remove('hidden');
    document.getElementById('adminDashboard').classList.add('hidden');
  }
}

function closeAdminModal() {
  const modal = document.getElementById('adminModal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}

async function verifyAdmin() {
  const password = document.getElementById('adminPasswordInput').value;
  try {
    const response = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password })
    });

    const data = await response.json();
    if (!response.ok) {
      showMsg(data.message || 'Mật khẩu không chính xác');
      return;
    }

    sessionStorage.setItem('isAdminLoggedIn', 'true');
    showAdminDashboard();
  } catch (error) {
    console.error(error);
    showMsg('Không thể xác thực quản trị viên.');
  }
}

function showAdminDashboard() {
  document.getElementById('adminLoginForm').classList.add('hidden');
  document.getElementById('adminDashboard').classList.remove('hidden');
  renderPendingPostsAdmin();
}

function logoutAdmin() {
  sessionStorage.removeItem('isAdminLoggedIn');
  document.getElementById('adminLoginForm').classList.remove('hidden');
  document.getElementById('adminDashboard').classList.add('hidden');
  document.getElementById('adminPasswordInput').value = '';
}

async function changeAdminPassword() {
  const currentPass = document.getElementById('currentPassInput').value;
  const newPass = document.getElementById('newPassInput').value;
  const confirmPass = document.getElementById('confirmPassInput').value;

  if (!currentPass || !newPass || !confirmPass) {
    showMsg('Vui lòng nhập đầy đủ thông tin.');
    return;
  }

  if (currentPass !== 'admin123') {
    showMsg('Mật khẩu hiện tại không chính xác!');
    return;
  }

  if (newPass.length < 3) {
    showMsg('Mật khẩu mới phải có ít nhất 3 ký tự!');
    return;
  }

  if (newPass !== confirmPass) {
    showMsg('Mật khẩu xác nhận không khớp với mật khẩu mới!');
    return;
  }

  localStorage.setItem(ADMIN_PASS_KEY, newPass);
  showMsg('Đổi mật khẩu quản trị thành công!');
  document.getElementById('currentPassInput').value = '';
  document.getElementById('newPassInput').value = '';
  document.getElementById('confirmPassInput').value = '';
}

