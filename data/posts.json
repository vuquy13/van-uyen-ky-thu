    options: ['Thơ Đường luật 7 chữ', 'Thể thơ Lục bát truyền thống', 'Thể thơ Song thất lục bát', 'Thơ tự do không vần'],
    correct: 1,
    explanation: 'Chính xác! Thể thơ Lục bát là linh hồn của Truyện Kiều và ca dao dân tộc.'
  },
  {
    q: 'Nhân vật Chí Phèo trong tác phẩm cùng tên của Nam Cao vốn là dân ngụ cư ở làng nào?',
    options: ['Làng Vũ Đại', 'Làng Đüm', 'Làng Chợ Dừa', 'Làng Yên Thế'],
    correct: 0,
    explanation: 'Chính xác! Chí Phèo sinh sống và gây giông bão tại làng Vũ Đại.'
  },
  {
    q: "Bài thơ 'Sóng' của Xuân Quỳnh được sáng tác năm nào?",
    options: ['1967', '1970', '1965', '1975'],
    correct: 0,
    explanation: "Chính xác! Bài thơ 'Sóng' ra đời năm 1967."
  },
  {
    q: "Câu nói nổi tiếng: 'Văn học là nhân học' là quan điểm của nhà văn nào?",
    options: ['Nam Cao', 'Thạch Lam', 'M. Gorky', 'Lép Tôn-xtôi'],
    correct: 2,
    explanation: 'Chính xác! Maxim Gorky đã khẳng định triết lý sâu sắc này.'
  },
  {
    q: "Trong bài thơ 'Tây Tiến', hình ảnh nào khắc họa vẻ đẹp bi tráng của người lính?",
    options: ['Áo chiến bào thay chiếu anh về đất', 'Đêm mơ Hà Nội dáng kiều thơm', 'Tây Tiến đoàn binh không mọc tóc', 'Cả 3 đáp án trên đều đúng'],
    correct: 3,
    explanation: 'Chính xác! Cả 3 hình ảnh trên đều góp thành bản hùng ca bi tráng.'
  }
];

let currentQuizIndex = 0;
let quizScore = 0;

function loadQuizQuestion() {
  if (currentQuizIndex >= quizBank.length) {
    currentQuizIndex = 0;
    quizScore = 0;
  }

  const q = quizBank[currentQuizIndex];
  document.getElementById('quizProgress').textContent = `Câu hỏi ${currentQuizIndex + 1} / ${quizBank.length}`;
  document.getElementById('quizScore').textContent = `Điểm: ${quizScore}`;
  document.getElementById('quizQuestion').textContent = q.q;

  const container = document.getElementById('quizOptions');
  container.innerHTML = q.options.map((opt, idx) => `
    <button
      class="quiz-option-btn w-full rounded border border-goldAccent/60 bg-white p-3 text-left text-sm transition hover:bg-goldAccent/10"
      onclick="handleQuizAnswer(${idx}, ${q.correct}, '${q.explanation.replace(/'/g, "\\'")}')"
    >
      ${String.fromCharCode(65 + idx)}. ${opt}
    </button>
  `).join('');

  const result = document.getElementById('quizResult');
  result.classList.add('hidden');
  document.getElementById('quizNextBtnContainer').classList.add('hidden');
}

function handleQuizAnswer(selectedIdx, correctIdx, explanation) {
  const btns = document.querySelectorAll('.quiz-option-btn');
  btns.forEach((btn, idx) => {
    btn.disabled = true;
    if (idx === correctIdx) {
      btn.classList.add('bg-green-100', 'border-green-600', 'font-bold');
    } else if (idx === selectedIdx && idx !== correctIdx) {
      btn.classList.add('bg-red-100', 'border-red-600');
    }
  });

  const result = document.getElementById('quizResult');
  if (selectedIdx === correctIdx) {
    quizScore += 10;
    result.className = 'mt-5 text-sm font-bold text-green-700';
    result.textContent = `✨ ${explanation}`;
  } else {
    result.className = 'mt-5 text-sm font-bold text-red-700';
    result.textContent = `❌ Chưa chính xác! ${explanation}`;
  }

  result.classList.remove('hidden');
  document.getElementById('quizScore').textContent = `Điểm: ${quizScore}`;
  document.getElementById('quizNextBtnContainer').classList.remove('hidden');
}

function nextQuizQuestion() {
  currentQuizIndex++;
  loadQuizQuestion();
}

function initPetalCanvas() {
  const canvas = document.getElementById('petalCanvas');
  const ctx = canvas.getContext('2d');
  const petals = [];

  function resizeCanvas() {
    const parent = canvas.parentElement;
    canvas.width = parent.clientWidth;
    canvas.height = parent.clientHeight;
  }

  function createPetal() {
    return {
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: 2 + Math.random() * 4,
      s: 0.5 + Math.random() * 1.5,
      a: Math.random() * Math.PI * 2
    };
  }

  function render() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    petals.forEach((p) => {
      p.a += 0.01;
      p.x += Math.sin(p.a) * 0.35;
      p.y += p.s;

      if (p.y > canvas.height + 20) {
        p.y = -20;
        p.x = Math.random() * canvas.width;
      }

      ctx.beginPath();
      ctx.fillStyle = 'rgba(197,160,89,0.7)';
      ctx.ellipse(p.x, p.y, p.r, p.r * 1.7, p.a, 0, Math.PI * 2);
      ctx.fill();
    });

    requestAnimationFrame(render);
  }

  function init() {
    resizeCanvas();
    petals.length = 0;
    for (let i = 0; i < 36; i++) petals.push(createPetal());
    render();
  }

  window.addEventListener('resize', resizeCanvas);
  init();
}

fetchPosts();
loadQuizQuestion();
initPetalCanvas();
